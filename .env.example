# Copy to .env (or export these in the shell). `npm run keys` can create the file for you.
# Never commit real keys. In a GitHub Codespace, store them as Codespaces secrets with the same names.

# Required: three different accounts on Studionet. The insured needs roughly 0.15 GEN, each backer 0.1 GEN.
INSURED_KEY=0x
BACKER_KEY=0x
BACKER2_KEY=0x

# Optional: a stranger that sends the unpaid calls (vet, bind, resolve, settle ...); random when empty.
OUTSIDER_KEY=

# Optional: use an existing deployment instead of deploying contracts/backstop.py first.
BACKSTOP_ADDRESS=0xaAFa4C63F2a2609b050Eb04E333ab909197985d1

# Optional tuning
# SOURCE_URL=https://www.iana.org/help/example-domains
# REPORT_DIR=reports
